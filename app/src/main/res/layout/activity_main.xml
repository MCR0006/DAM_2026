<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:padding="32dp" android:background="@color/fundo">
    <EditText android:id="@+id/editNumero1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/primeiro_numero"
        android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
    <EditText android:id="@+id/editNumero2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:hint="@string/segundo_numero" android:inputType="numberDecimal|numberSigned"
        android:importantForAutofill="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonSomar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="calcular"
            android:text="@string/somar" />

        <Button
            android:id="@+id/buttonSubtrair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="calcular"
            android:text="@string/subtrair" />

        <Button
            android:id="@+id/buttonMultiplicar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="calcular"
            android:text="@string/multiplicar" />

        <Button
            android:id="@+id/buttonDividir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="calcular"
            android:text="@string/dividir" />
    </LinearLayout>
        android:backgroundTint="@color/roxo" />
    <TextView android:id="@+id/textResultado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:gravity="center" android:textSize="20sp" android:textColor="@color/texto" />
</LinearLayout>
